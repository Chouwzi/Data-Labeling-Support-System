# Application configuration
SERVER_PORT=8080
CONTEXT_PATH=/api/v1

# Database configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/demo
DB_USERNAME=postgres
DB_PASSWORD=secret

# Security configuration (JWT)
JWT_SECRET=ChangeThisSecretKeyToASecureValue1234567890
JWT_EXPIRATION=3600
JWT_ISSUER=datalabeling-api

# Upload storage (Local)
UPLOAD_DIR=uploads/
STORAGE_STRATEGY=cloudinary

# Cloudinary (Cloud)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
